# Resume PDF hosted on Vercel Blob (https://vercel.com/docs/storage/vercel-blob)
# Upload your resume.pdf to Vercel Blob and paste the public URL here.
# Re-uploading to the same path updates the file without needing a redeploy.
PUBLIC_RESUME_URL=https://<your-store>.public.blob.vercel-storage.com/resume.pdf

# Optional: override the site URL (defaults to shashikanth.vercel.app)
# SITE_URL=https://your-custom-domain.com
